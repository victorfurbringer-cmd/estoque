# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA suba o arquivo .env para o Git (ele esta no .gitignore).

# Porta em que a API vai rodar
PORT=3000

# Conexao com o banco MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=controle_estoque

# Chave secreta para assinar os tokens JWT (troque por um texto aleatorio)
JWT_SECRET=troque_esta_chave_por_algo_bem_secreto
JWT_EXPIRES_IN=8h
